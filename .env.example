# Postgres connection string used by both the app and drizzle-kit.
DATABASE_URL=postgres://budget:budget@localhost:5439/monthly_budget

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Single shared household login credentials (bcrypt-hashed password is
# generated by scripts/seed.ts from this plaintext on first run).
HOUSEHOLD_LOGIN_EMAIL=you@example.com
HOUSEHOLD_LOGIN_PASSWORD=change-me

# AES-256-GCM key for encrypting SimpleFin Access URLs at rest.
# Generate with `openssl rand -base64 32`
SIMPLEFIN_ENCRYPTION_KEY=

# Optional - enables AI categorization suggestions (Claude Haiku) on the
# Transactions > Categorize page. Get a key at https://platform.claude.com.
# Everything else works without it.
ANTHROPIC_API_KEY=

# Optional - long-lived bearer token for the MCP endpoint (/api/mcp), used
# by Home Assistant Assist. Generate one with: openssl rand -hex 32
# Unset = MCP endpoint disabled. See docs/mcp-home-assistant.md.
MCP_AUTH_TOKEN=

# How many days of daily DB backups (scripts/backup/backup.sh) to keep in
# ./backups before older ones are pruned. See docs/backup-restore.md.
BACKUP_RETENTION_DAYS=14
