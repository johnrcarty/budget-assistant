# Docker Compose reads this file when copied to .env.
# scripts/dev.sh and scripts/run.sh use exported environment variables.
BUDGET_AUTH_MODE=local
BUDGET_LOCAL_AUTH=true
BUDGET_INGRESS_PROXY=172.30.32.2
BUDGET_DEMO=0
BUDGET_TIMEZONE=America/New_York
BUDGET_DATA_DIR=./data
# Keep localhost by default. Set to 0.0.0.0 for trusted LAN development.
BUDGET_BIND_ADDRESS=127.0.0.1
